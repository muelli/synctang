#!/usr/bin/make -f
# SPDX-License-Identifier: AGPL-3.0-or-later

# CGO_ENABLED=0 gives fully static binaries: nothing dynamically linked to
# track (see the dh_strip/dh_shlibdeps/dh_makeshlibs/dh_dwz overrides
# below, which rely on exactly this). GOFLAGS=-trimpath keeps this build
# host's filesystem paths out of the binaries. GOCACHE is pointed inside
# the build tree rather than left at its default under $HOME, so the
# build is hermetic to this package build and override_dh_auto_clean
# below has one single place to remove it from.
export CGO_ENABLED = 0
export GOFLAGS = -trimpath
export GOCACHE = $(CURDIR)/.gocache

# This project does not vendor its Go module dependencies (see
# AGENTS.md's "decisions already made"), so -mod=vendor is deliberately
# not used here, unlike some Go packaging references. That means this
# build needs network access (or a pre-warmed GOPATH/pkg/mod) to fetch
# module sources, same as any other "go build" against this repo. That
# is an accepted constraint on the build environment, not an oversight;
# it is also why -d is required on the dpkg-buildpackage command line
# (see the justfile's "deb" target): Build-Depends above names no Go
# toolchain at all, so dpkg-checkbuilddeps would otherwise refuse to
# build without one, even though a Go toolchain is exactly what actually
# builds this package.

# dpkg-architecture gives the Debian architecture name; Go wants its own
# GOARCH spelling, which is not always the same string (e.g. Debian's
# "armhf" is Go's "arm" plus GOARM=7). Only amd64 and arm64 are needed
# today; fail loudly on anything else rather than silently falling back
# to the build host's own architecture, which "go build" would otherwise
# do without complaint.
DEB_HOST_ARCH := $(shell dpkg-architecture -qDEB_HOST_ARCH)
ifeq ($(DEB_HOST_ARCH),amd64)
GOARCH_HOST := amd64
else ifeq ($(DEB_HOST_ARCH),arm64)
GOARCH_HOST := arm64
else
$(error unsupported Debian architecture $(DEB_HOST_ARCH): add a GOARCH mapping in debian/rules)
endif

%:
	dh $@

# -buildvcs=false: by default "go build" stamps VCS information (commit
# hash, and a dirty/clean flag) into the binary, so the same source
# produces a different binary depending on the state of the working tree
# it happens to be built from (e.g. a shallow clone, or one with an
# untracked file lying around). That is exactly the kind of accidental
# input a reproducible build must not depend on.
#
# The version the programs report with --version is the package's own, from debian/changelog, set here
# (-X) so that it is the string dpkg shows; the same commit always gives the same one.
VERSION := $(shell dpkg-parsechangelog -SVersion)
LDFLAGS := -s -w -X github.com/muelli/synctang/internal/version.Version=$(VERSION)

override_dh_auto_build:
	GOARCH=$(GOARCH_HOST) go build -buildvcs=false -ldflags "$(LDFLAGS)" -o synctang-unlocker ./cmd/synctang-unlocker
	GOARCH=$(GOARCH_HOST) go build -buildvcs=false -ldflags "$(LDFLAGS)" -o synctang-keyholder ./cmd/synctang-keyholder

override_dh_auto_test:
	# Deliberately empty. The test suite needs real cryptsetup (loopback
	# LUKS, CAP_SYS_ADMIN) and network access (relay and discovery
	# transports), neither of which a package build provides or should
	# rely on. CI runs both the plain and privileged suites separately
	# (the go-test and go-test-privileged jobs).

override_dh_auto_install:
	install -D -m 0755 synctang-unlocker debian/tmp/usr/sbin/synctang-unlocker
	install -D -m 0755 synctang-keyholder debian/tmp/usr/bin/synctang-keyholder
	install -d debian/tmp/usr/lib/dracut/modules.d/90synctang
	install -m 0755 dracut/90synctang/module-setup.sh dracut/90synctang/synctang-start.sh \
		dracut/90synctang/synctang-stop.sh dracut/90synctang/secure-initrd.sh \
		dracut/90synctang/synctang-lib.sh \
		debian/tmp/usr/lib/dracut/modules.d/90synctang/
	# Shell completion, written by the programs themselves from their own usage and flag
	# help (internal/completion), so it cannot drift from the commands and flags they have.
	# A program built for another architecture may not run on this build host, and the
	# text does not depend on the architecture, so a build for the host's own writes it.
	install -d debian/tmp/usr/share/bash-completion/completions \
		debian/tmp/usr/share/zsh/vendor-completions \
		debian/tmp/usr/share/fish/vendor_completions.d
	for p in synctang-unlocker synctang-keyholder; do \
		GOARCH=$$(go env GOHOSTARCH) go build -buildvcs=false -o completion-writer ./cmd/$$p && \
		./completion-writer completion bash > debian/tmp/usr/share/bash-completion/completions/$$p && \
		./completion-writer completion zsh > debian/tmp/usr/share/zsh/vendor-completions/_$$p && \
		./completion-writer completion fish > debian/tmp/usr/share/fish/vendor_completions.d/$$p.fish || exit 1; \
	done
	rm -f completion-writer

override_dh_auto_clean:
	rm -f synctang-unlocker synctang-keyholder completion-writer
	rm -rf $(CURDIR)/.gocache

# CGO_ENABLED=0 above means both binaries are fully static, so none of
# the shared-library machinery below has anything to do. Running it
# anyway would, on a cross build, pull in a target-architecture
# binutils/objdump/etc purely to conclude "nothing to strip" or "nothing
# to depend on", which is exactly the extra Build-Depends a cross build
# should not need. dh_strip is also redundant on its own terms: linking
# already happened with -ldflags "-s -w", so there is nothing left to
# strip. dh_dwz would try to optimise Go's DWARF, which is already
# compressed in a way dh_dwz does not understand and errors on.
override_dh_strip:

override_dh_shlibdeps:

override_dh_makeshlibs:

override_dh_dwz:
