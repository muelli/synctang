#
# The build and test environment for the Android app: JDK, Go, the Android
# SDK and an x86_64 emulator image. Run it on any machine with KVM:
#
#   podman build -t synctang-emulator -f scripts/emulator-vm/Containerfile scripts/emulator-vm
#   podman run --rm -it --device /dev/kvm -v "$PWD":/work -w /work synctang-emulator bash
#
# The container process needs read-write access to /dev/kvm, and a rootless
# container does not inherit your supplementary groups under runc
# (`--group-add keep-groups` only works with crun) `[V]` (failed here, on
# runc, with the node at root:kvm 0660). Either use crun and keep-groups, or
# make the node world accessible with a udev rule, which is what the VM
# does (vm-setup.sh).
ARG BASE=docker.io/library/ubuntu:26.04
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl unzip git procps iproute2 xz-utils \
      openjdk-21-jdk-headless golang-go \
      libpulse0 libnss3 libgl1 libx11-6 libxcb1 libasound2t64 libxkbcommon0 libdbus-1-3 \
 && rm -rf /var/lib/apt/lists/*

# Google publishes a SHA-1 for this archive (repository2-3.xml); the SHA-256
# below is of the same file, checked against it on 2026-10-27. A new version
# of the tools means updating both the file name and this hash.
ARG CMDLINE_TOOLS=commandlinetools-linux-16111833_latest.zip
ARG CMDLINE_TOOLS_SHA256=0877a1d048fe4a24efe2eff536ca4223f7adeb58648bb81909d33c446918cfa8

ENV ANDROID_HOME=/opt/android-sdk \
    JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64 \
    GOPATH=/root/go
ENV PATH=${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${ANDROID_HOME}/emulator:${GOPATH}/bin:${PATH}

RUN mkdir -p "${ANDROID_HOME}/cmdline-tools" \
 && curl -fsSL -o /tmp/cmdline-tools.zip "https://dl.google.com/android/repository/${CMDLINE_TOOLS}" \
 && echo "${CMDLINE_TOOLS_SHA256}  /tmp/cmdline-tools.zip" | sha256sum -c - \
 && unzip -q /tmp/cmdline-tools.zip -d "${ANDROID_HOME}/cmdline-tools" \
 && mv "${ANDROID_HOME}/cmdline-tools/cmdline-tools" "${ANDROID_HOME}/cmdline-tools/latest" \
 && rm /tmp/cmdline-tools.zip

# The same pieces the emulator workflow installs, so a result here means
# the same thing there. Overridable so the image can be built quickly for a
# test of the Containerfile itself.
ARG SDK_PACKAGES="platform-tools emulator platforms;android-34 build-tools;34.0.0 system-images;android-34;google_apis;x86_64 ndk;27.2.12479018"
RUN yes | sdkmanager --licenses >/dev/null \
 && for p in ${SDK_PACKAGES}; do echo "installing $p"; sdkmanager --install "$p"; done

WORKDIR /work
