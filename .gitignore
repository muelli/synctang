/*.img
*.aar
/android/.gradle/
/android/local.properties
/android/**/.gradle/
/android/**/local.properties
/android/**/build/
*.keystore
*.jks
/.claude/

# Debian packaging: debian/changelog is generated by "just deb" from the git
# commit count, never committed; the rest are dpkg-buildpackage/debhelper
# build artefacts a local "just deb" leaves lying around otherwise.
/debian/changelog
/debian/.debhelper/
/debian/debhelper-build-stamp
/debian/*.substvars
/debian/files
/debian/tmp/
/debian/synctang-*/
/.gocache/
*.deb
*.buildinfo
*.changes
/dist/
/dist-a/
/dist-b/

# debian/rules' override_dh_auto_build builds these at the repo root;
# override_dh_auto_clean removes them again, but only on the next clean.
/unlocker
/keyholder
/sbom/
